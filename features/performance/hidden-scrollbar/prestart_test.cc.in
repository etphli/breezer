#define FROM_HERE 0
#define TRACE_EVENT1(...) ((void)0)
template<class T> class scoped_refptr {
 public:
  scoped_refptr(T* p) : p_(p) { if (p_) p_->AddRef(); }
  scoped_refptr(const scoped_refptr& p) : scoped_refptr(p.p_) {}
  template<class U> scoped_refptr(const scoped_refptr<U>& p) : scoped_refptr(p.get()) {}
  scoped_refptr& operator=(const scoped_refptr& p) {
    if (p.p_) p.p_->AddRef();
    if (p_) p_->Release();
    p_ = p.p_; return *this;
  }
  ~scoped_refptr() { if (p_) p_->Release(); }
  T* operator->() const { return p_; }
  T* get() const { return p_; }
 private: T* p_;
};
namespace base {
template<class T> class WeakPtr {
 public:
  WeakPtr(T* p,std::weak_ptr<int> token) : p_(p),token_(token) {}
  T* get() const { return token_.expired() ? nullptr : p_; }
 private: T* p_; std::weak_ptr<int> token_;
};
template<class T> class WeakPtrFactory {
 public:
  explicit WeakPtrFactory(T* p) : p_(p) {}
  WeakPtr<T> GetWeakPtr() { return {p_,token_}; }
 private: T* p_; std::shared_ptr<int> token_=std::make_shared<int>(0);
};
struct TimeDelta { int ms = 0; bool is_zero() const { return ms == 0; } };
TimeDelta Milliseconds(int v) { return {v}; }
template<class T, class... A> scoped_refptr<T> MakeRefCounted(A&&... a) {
  return new T(std::forward<A>(a)...);
}
template<class T> T* Unretained(T* p) { return p; }
template<class M, class T> auto BindOnce(M m, T* p) { return [m,p] { (p->*m)(); }; }
}
namespace gfx {
struct Vector2d { int x=0, y=0; };
struct Point { int x=0,y=0; Vector2d OffsetFromOrigin() const { return {x,y}; } };
struct Size {
  int w=9,h=9;
  bool operator==(const Size&) const = default;
};
struct Rect {
  Rect() = default;
  explicit Rect(Size s) : w(s.w),h(s.h) {}
  Rect(int x,int y,int w,int h) : xx(x),yy(y),w(w),h(h) {}
  int xx=0,yy=0,w=9,h=9;
  int x() const { return xx; } int y() const { return yy; }
  int width() const { return w; } int height() const { return h; }
  Size size() const { return {w,h}; }
  Vector2d OffsetFromOrigin() const { return {xx,yy}; }
  Rect operator+(Vector2d v) const { return {xx+v.x,yy+v.y,w,h}; }
  bool operator==(const Rect&) const = default;
};
using RectF = Rect;
}
struct State {
  bool timer=false;
  unsigned active=0;
  gfx::Rect bounds,target_bounds;
  float opacity=1,target_opacity=1;
  int starts=0,stops=0,fade_duration=0;
  int requests=0,collection_starts=0,completed=0,opacity_requests=0;
  int ax_updates=0,layouts=0,layer_notifications=0,paint_bounds=0,snaps=0;
  std::function<void(unsigned)> on_completed;
  std::function<void()> on_base_destructor;
};
namespace ui {
struct MouseEvent {};
enum class PropertyChangeReason { NOT_FROM_ANIMATION };
struct TargetValue;
struct LayerAnimationElement {
  using TargetValue = ui::TargetValue;
  enum AnimatableProperty { BOUNDS=1,OPACITY=2,TRANSFORM=4 };
  gfx::Rect target; base::TimeDelta duration;
  static std::unique_ptr<LayerAnimationElement> CreateBoundsElement(
      const gfx::Rect& v, base::TimeDelta d) {
    return std::make_unique<LayerAnimationElement>(LayerAnimationElement{v,d});
  }
  void set_tween_type(int) {}
};
struct LayerAnimationSequence {
  explicit LayerAnimationSequence(std::unique_ptr<LayerAnimationElement> e) : element(std::move(e)) {}
  std::unique_ptr<LayerAnimationElement> element;
};
class Layer;
class LayerAnimationDelegate {
 public:
  virtual ~LayerAnimationDelegate() = default;
  virtual Layer* GetLayer() = 0;
  virtual void SetBoundsFromAnimation(const gfx::Rect&, PropertyChangeReason) = 0;
};
class LayerAnimator {
 public:
  enum PreemptionStrategy { IMMEDIATELY_SET_NEW_TARGET,ENQUEUE_NEW_ANIMATION };
  explicit LayerAnimator(base::TimeDelta d) : duration_(d) {}
  void AddRef() { ++refs_; }
  void Release() { if (--refs_ == 0) delete this; }
  static scoped_refptr<LayerAnimator> CreateImplicitAnimator() { return new LayerAnimator({120}); }
  virtual void SetBounds(const gfx::Rect&);
  gfx::Rect GetTargetBounds() const;
  virtual void SetOpacity(float v) { ++s->opacity_requests; s->target_opacity=v; s->active |= LayerAnimationElement::OPACITY; }
  void SetTransform() { s->active |= LayerAnimationElement::TRANSFORM; }
  void StopAnimatingProperty(LayerAnimationElement::AnimatableProperty p) {
    scoped_refptr<LayerAnimator> retain(this);
    if (!(s->active&p)) return;
    s->active &= ~p;
    if (!delegate()) return;
    if (p==LayerAnimationElement::BOUNDS) s->bounds=s->target_bounds;
    if (p==LayerAnimationElement::OPACITY) s->opacity=s->target_opacity;
    ++s->completed;
    auto callback=s->on_completed;
    if (callback) callback(p);
  }
  void StartAnimation(LayerAnimationSequence* raw) {
    std::unique_ptr<LayerAnimationSequence> sequence(raw);
    ++s->requests; ++s->collection_starts;
    s->active |= LayerAnimationElement::BOUNDS;
    s->target_bounds=sequence->element->target;
  }
  void GetTargetValue(struct TargetValue*) const;
  base::TimeDelta GetTransitionDuration() const { return duration_; }
  std::shared_ptr<State> s;
  LayerAnimationDelegate* delegate_=nullptr;
  PreemptionStrategy preemption_strategy_=IMMEDIATELY_SET_NEW_TARGET;
  int tween_type_=0;
  struct WeakFactory { bool GetWeakPtr() { return true; } } weak_ptr_factory_;
 protected:
  virtual ~LayerAnimator() = default;
  LayerAnimationDelegate* delegate() const { return delegate_; }
 private: int refs_=0; base::TimeDelta duration_;
};
struct TargetValue { explicit TargetValue(LayerAnimationDelegate*) {} gfx::Rect bounds; };
// Alias expected by the exact getter expansion.
// @ANIMATOR_DECL_ALIAS@
void LayerAnimator::GetTargetValue(TargetValue* t) const { t->bounds=s->target_bounds; }
class Layer : public LayerAnimationDelegate {
 public:
  explicit Layer(std::shared_ptr<State> s) : s(s), animator_(new LayerAnimator({0})) {
    animator_->s=s; animator_->delegate_=this;
  }
  ~Layer() { animator_->delegate_=nullptr; }
  Layer* GetLayer() override { return this; }
  void SetBoundsFromAnimation(const gfx::Rect& v, PropertyChangeReason) override {
    s->bounds=v;
    if (!(s->active & LayerAnimationElement::BOUNDS)) s->target_bounds=v;
  }
  void SetBounds(const gfx::Rect&);
  LayerAnimator* GetAnimator() { return animator_.get(); }
  void SetAnimator(scoped_refptr<LayerAnimator> a) {
    animator_->delegate_=nullptr; animator_=a;
    animator_->s=s; animator_->delegate_=this;
  }
  void SetOpacity(float v) { GetAnimator()->SetOpacity(v); }
  float GetTargetOpacity() { return s->target_opacity; }
  void SetFillsBoundsOpaquely(bool) {}
  float device_scale_factor() const { return 1; }
  gfx::Size size() const { return s->bounds.size(); }
  std::shared_ptr<State> s;
 private: scoped_refptr<LayerAnimator> animator_;
};
class ScopedLayerAnimationSettings {
 public:
  explicit ScopedLayerAnimationSettings(LayerAnimator* a) : a_(a) {}
  void SetTransitionDuration(int d) { a_->s->fade_duration=d; }
 private: scoped_refptr<LayerAnimator> a_;
};
int GetOverlayScrollbarFadeDuration() { return 200; }
int GetOverlayScrollbarFadeDelay() { return 500; }
