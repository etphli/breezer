{
  "manifest_version": 3,
  "name": "Breezer disposable sync test provider",
  "version": "0.0.1",
  "description": "Loopback-only ciphertext transport for disposable Breezer sync tests. Not a cloud service.",
  "permissions": ["syncVaultProvider", "storage"],
  "host_permissions": ["http://127.0.0.1:18765/*"],
  "sync_vault_provider": { "api_version": 1 },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:18765"
  }
}
