{
  "manifest_version": 3,
  "name": "Breezer AI",
  "description": "Ask about this page and control your browser with your local AI assistant.",
  "version": "0.2.0",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "debugger",
    "sidePanel",
    "nativeMessaging",
    "storage",
    "favicon",
    "sessions"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Ask Breezer"
  },
  "icons": {
    "128": "icon128.png"
  },
  "commands": {
    "toggle-breezer-ai": {
      "description": "Toggle Breezer AI"
    },
    "space-1": {
      "description": "Switch to space 1",
      "suggested_key": {
        "mac": "MacCtrl+1",
        "default": "Ctrl+Shift+1"
      }
    },
    "space-2": {
      "description": "Switch to space 2",
      "suggested_key": {
        "mac": "MacCtrl+2",
        "default": "Ctrl+Shift+2"
      }
    },
    "space-3": {
      "description": "Switch to space 3",
      "suggested_key": {
        "mac": "MacCtrl+3",
        "default": "Ctrl+Shift+3"
      }
    },
    "space-4": {
      "description": "Switch to space 4",
      "suggested_key": {
        "mac": "MacCtrl+4",
        "default": "Ctrl+Shift+4"
      }
    }
  },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
