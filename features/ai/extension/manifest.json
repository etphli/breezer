{
  "manifest_version": 3,
  "name": "Breezer AI",
  "description": "Ask about this page and control your browser with your local AI assistant.",
  "version": "0.1.0",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "debugger",
    "sidePanel",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Ask Breezer"
  },
  "icons": {
    "128": "icon128.png"
  },
  "commands": {
    "toggle-breezer-ai": {
      "description": "Toggle Breezer AI"
    }
  },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
