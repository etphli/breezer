+namespace {
+
+class BreezerLoginSubmitListener final : public NativeEventListener {
+ public:
+  void Invoke(ExecutionContext*, Event* event) override {
+    ++count;
+    event->preventDefault();
+  }
+  int count = 0;
+};
+
+KeyboardEvent* BreezerLoginEnter(KeyboardEventInit* init = nullptr,
+                                bool trusted = true) {
+  if (!init) {
+    init = KeyboardEventInit::Create();
+  }
+  init->setCharCode('\r');
+  init->setBubbles(true);
+  init->setCancelable(true);
+  auto* event =
+      MakeGarbageCollected<KeyboardEvent>(event_type_names::kKeypress, init);
+  event->SetTrusted(trusted);
+  return event;
+}
+
+constexpr char kBreezerLoginForm[] =
+    "<form id=f method=post>"
+    "<input id=u autocomplete=username required value=dummy>"
+    "<input id=p type=password autocomplete=current-password required "
+    "value=dummy-only></form>";
+
+}  // namespace
+
+TEST_F(HTMLFormElementTest, BreezerLoginEnterAdvancesThenSubmitsOnce) {
+  GetDocument().body()->SetInnerHTMLWithoutTrustedTypes(kBreezerLoginForm);
+  auto* listener = MakeGarbageCollected<BreezerLoginSubmitListener>();
+  GetFormElement("f")->addEventListener(event_type_names::kSubmit, listener, false);
+  auto* username = GetElementById("u");
+  auto* password = GetElementById("p");
+  username->Focus();
+  username->DispatchEvent(*BreezerLoginEnter());
+  EXPECT_EQ(GetDocument().FocusedElement(), password);
+  EXPECT_EQ(listener->count, 0);
+  password->DispatchEvent(*BreezerLoginEnter());
+  EXPECT_EQ(listener->count, 1);
+}
+
+TEST_F(HTMLFormElementTest, BreezerLoginEnterRejectsSyntheticCompositionAndModifiers) {
+  GetDocument().body()->SetInnerHTMLWithoutTrustedTypes(kBreezerLoginForm);
+  auto* username = GetElementById("u");
+  username->Focus();
+  username->DispatchEvent(*BreezerLoginEnter(nullptr, false));
+  EXPECT_EQ(GetDocument().FocusedElement(), username);
+  for (int modifier = 0; modifier < 6; ++modifier) {
+    auto* init = KeyboardEventInit::Create();
+    init->setIsComposing(modifier == 0);
+    init->setRepeat(modifier == 1);
+    init->setCtrlKey(modifier == 2);
+    init->setAltKey(modifier == 3);
+    init->setMetaKey(modifier == 4);
+    init->setShiftKey(modifier == 5);
+    username->DispatchEvent(*BreezerLoginEnter(init));
+    EXPECT_EQ(GetDocument().FocusedElement(), username);
+  }
+}
+
+TEST_F(HTMLFormElementTest, BreezerLoginEnterDoesNotBypassOtherControls) {
+  for (const char* extra : {"<button disabled>Sign in</button>",
+                            "<button type=button>Next</button>",
+                            "<input autocomplete=one-time-code>",
+                            "<input type=checkbox required>",
+                            "<textarea></textarea>"}) {
+    GetDocument().body()->SetInnerHTMLWithoutTrustedTypes(
+        String(kBreezerLoginForm) + extra);
+    // Associate the additional control with this form even outside its subtree.
+    GetDocument().body()->lastElementChild()->setAttribute(
+        html_names::kFormAttr, AtomicString("f"));
+    auto* listener = MakeGarbageCollected<BreezerLoginSubmitListener>();
+    GetFormElement("f")->addEventListener(event_type_names::kSubmit, listener, false);
+    auto* username = GetElementById("u");
+    auto* password = GetElementById("p");
+    username->Focus();
+    username->DispatchEvent(*BreezerLoginEnter());
+    EXPECT_EQ(GetDocument().FocusedElement(), username);
+    password->Focus();
+    password->DispatchEvent(*BreezerLoginEnter());
+    EXPECT_EQ(listener->count, 0);
+  }
+}
+
+TEST_F(HTMLFormElementTest, BreezerLoginEnterKeepsValidation) {
+  GetDocument().body()->SetInnerHTMLWithoutTrustedTypes(kBreezerLoginForm);
+  auto* listener = MakeGarbageCollected<BreezerLoginSubmitListener>();
+  GetFormElement("f")->addEventListener(event_type_names::kSubmit, listener, false);
+  auto* password = To<HTMLInputElement>(GetElementById("p"));
+  password->SetValue(g_empty_string);
+  password->Focus();
+  password->DispatchEvent(*BreezerLoginEnter());
+  EXPECT_EQ(listener->count, 0);
+  password->SetValue("dummy-only");
+  auto* username = To<HTMLInputElement>(GetElementById("u"));
+  username->setCustomValidity("Site validation");
+  password->DispatchEvent(*BreezerLoginEnter());
+  EXPECT_EQ(listener->count, 0);
+}
 
