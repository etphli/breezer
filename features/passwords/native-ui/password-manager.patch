+bool ManagePasswordsUIController::ShouldShowSaveUpdateChip() const {
+  return (GetState() == password_manager::ui::PENDING_PASSWORD_STATE ||
+          GetState() == password_manager::ui::PENDING_PASSWORD_UPDATE_STATE) &&
+         GetSavingPromptStatus() == SavingPromptStatus::kCanShow &&
+         passwords_data_.client()->IsSavingAndFillingEnabled(GetOrigin()) &&
+         !IsAutomaticallyOpeningBubble() && !IsShowingBubble() &&
+         !BubbleManagerHasPasswordBubbleInQueue() &&
+         !passwords_data_.client()->IsActorTaskActive() &&
+         !IsPasswordChangeOngoing();
+}
