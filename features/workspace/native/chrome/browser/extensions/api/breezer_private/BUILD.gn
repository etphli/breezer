import("//extensions/buildflags/buildflags.gni")
import("//pdf/features.gni")

assert(enable_extensions)

source_set("breezer_private") {
  sources = [
    "breezer_private_api.cc",
    "breezer_private_api.h",
    "browser_stats_api.cc",
    "omnibox_api.cc",
    "extensions_menu_api.cc",
    "pdf_context_api.cc",
    "research_text.h",
    "workspace_sync_api.cc",
  ]

  public_deps = [ "//extensions/browser" ]

  deps = [
    "//base",
    "//chrome/browser/autocomplete",
    "//chrome/browser/extensions",
    "//chrome/browser/omnibox",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/themes",
    "//chrome/browser/sync",
    "//components/sync/service",
    "//components/sync/base",
    "//chrome/browser/ui:browser_commands",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/extensions",
    "//chrome/browser/ui/helium:helium_layout_state_controller",
    "//chrome/browser/ui/navigator",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/browser/ui/tabs:tabs",
    "//chrome/browser/ui/views/breezer_peek",
    "//chrome/common:constants",
    "//components/bookmarks/common",
    "//components/omnibox/browser",
    "//components/omnibox/common",
    "//components/prefs",
    "//components/search_engines",
    "//components/split_tabs",
    "//components/tabs:public",
    "//content/public/browser",
    "//extensions/common",
    "//extensions/common:mojom",
    "//pdf:buildflags",
    "//services/resource_coordinator/public/cpp/memory_instrumentation",
    "//skia",
    "//third_party/metrics_proto",
    "//ui/base",
    "//ui/base/mojom",
    "//url",
  ]

  if (enable_pdf) {
    deps += [
      "//components/pdf/browser",
      "//components/pdf/common:constants",
      "//components/viz/common",
      "//pdf:features",
      "//ui/gfx/codec",
      "//ui/gfx/geometry",
    ]
  }
}
