namespace breezerPrivate {
  enum Layout {
    sidebar,
    top
  };

  enum SidebarMode {
    expanded,
    compact,
    autoHide
  };

  enum Theme {
    mint,
    tide,
    dusk,
    rose,
    pollen,
    graphite
  };

  enum ColorMode {
    system,
    light,
    dark
  };

  dictionary Appearance {
    Layout layout;
    SidebarMode sidebarMode;
    Theme theme;
    ColorMode colorMode;
    boolean showBookmarks;
    long sidebarWidth;
    // Integer pixels, 12..20 inclusive, default 15.
    long sidebarFontSize;
    boolean centeredAddressBar;
    boolean minimalUrl;
    boolean showLoadProgress;
    boolean frameless;
    boolean alwaysShowSidebar;
    boolean alwaysShowTopBar;
  };

  dictionary AppearancePatch {
    Layout? layout;
    SidebarMode? sidebarMode;
    Theme? theme;
    ColorMode? colorMode;
    boolean? showBookmarks;
    long? sidebarWidth;
    // Integer pixels, 12..20 inclusive, default 15.
    long? sidebarFontSize;
    boolean? centeredAddressBar;
    boolean? minimalUrl;
    boolean? showLoadProgress;
    boolean? frameless;
    boolean? alwaysShowSidebar;
    boolean? alwaysShowTopBar;
  };

  callback AppearanceCallback = void(Appearance appearance);
  callback BooleanCallback = void(boolean allowed);
  callback VoidCallback = void();

  interface Functions {
    static void getAppearance(AppearanceCallback callback);
    static void setAppearance(
        AppearancePatch patch,
        AppearanceCallback callback);
    static void setSidebarCollapsed(
        boolean collapsed,
        optional VoidCallback callback);
    static void authorizeCurrentPage(BooleanCallback callback);
  };
};
