// Private APIs used by the bundled Breezer extension.
namespace breezerPrivate {
  enum Layout {
    sidebar,
    top
  };

  enum SidebarMode {
    expanded,
    compact,
    autoHide
  };

  enum BookmarkBarMode {
    newTab,
    always,
    hidden
  };

  enum ColorMode {
    system,
    light,
    dark
  };

  enum NativeDefaultTheme {
    baseline,
    grayscale
  };

  dictionary Appearance {
    boolean? nativeGlass;
    Layout layout;
    SidebarMode sidebarMode;
    DOMString theme;
    ColorMode colorMode;
    boolean themeCanRestore;
    // The unseeded browser theme can differ from the visible Breezer palette.
    NativeDefaultTheme? nativeDefaultTheme;
    boolean showBookmarks;
    BookmarkBarMode bookmarkBarMode;
    long sidebarWidth;
    // Integer pixels, 12..20 inclusive, default 15.
    long sidebarFontSize;
    boolean centeredAddressBar;
    boolean minimalUrl;
    boolean showLoadProgress;
    boolean frameless;
    boolean alwaysShowSidebar;
    boolean alwaysShowTopBar;
    boolean sidebarAddressSearch;
    boolean newTabComposer;
  };

  dictionary ThemeState {
    DOMString theme;
    ColorMode colorMode;
    NativeDefaultTheme? nativeDefaultTheme;
  };

  dictionary AppearancePatch {
    boolean? nativeGlass;
    Layout? layout;
    SidebarMode? sidebarMode;
    DOMString? theme;
    ColorMode? colorMode;
    boolean? showBookmarks;
    BookmarkBarMode? bookmarkBarMode;
    long? sidebarWidth;
    // Integer pixels, 12..20 inclusive, default 15.
    long? sidebarFontSize;
    boolean? centeredAddressBar;
    boolean? minimalUrl;
    boolean? showLoadProgress;
    boolean? frameless;
    boolean? alwaysShowSidebar;
    boolean? alwaysShowTopBar;
    boolean? sidebarAddressSearch;
    boolean? newTabComposer;
    NativeDefaultTheme? nativeDefaultTheme;
    ThemeState? expectedThemeState;
  };

  dictionary ResearchTab {
    long tabId;
    DOMString documentId;
    DOMString url;
    DOMString title;
    boolean loading;
  };
  dictionary ResearchText {
    DOMString text;
    boolean truncated;
    long capturedCharacters;
  };
  callback ResearchTabsCallback = void(ResearchTab[] tabs);
  callback ResearchTextCallback = void(ResearchText page);

  dictionary SystemMemory {
    double? totalBytes;
    double? availableBytes;
  };
  dictionary BrowserMemory {
    double? footprintBytes;
    double? browserProcessBytes;
    long measuredProcessCount;
    boolean sampleComplete;
  };
  dictionary BrowserStatsTab {
    long tabId;
    DOMString title;
    long[] rendererProcessIds;
    boolean? rendererDetailsTruncated;
  };
  dictionary RendererMemory {
    long id;
    double? footprintBytes;
    boolean shared;
  };
  dictionary BrowserStats {
    long totalTabCount;
    long? windowTabCount;
    SystemMemory systemMemory;
    BrowserMemory browserMemory;
    BrowserStatsTab[] tabs;
    RendererMemory[] rendererProcesses;
    boolean detailsTruncated;
  };
  callback BrowserStatsCallback = void(BrowserStats stats);

  callback AppearanceCallback = void(Appearance appearance);
  callback BooleanCallback = void(boolean allowed);
  callback VoidCallback = void();

  dictionary PdfPageContext {
    boolean isPdf;
    DOMString? imageDataUrl;
  };
  callback PdfPageContextCallback = void(PdfPageContext context);

  // Workspace metadata only; native passwords and vault keys are never exposed.
  dictionary WorkspaceSyncState {
    boolean configured;
    boolean workspaceEnabled;
    // Preferences are active and their initial download has finished.
    boolean workspaceReady;
    boolean nativeError;
    DOMString nativeMessage;
    DOMString providerId;
    DOMString vaultId;
    DOMString model;
  };
  dictionary WorkspaceSyncExchange {
    DOMString providerId;
    DOMString vaultId;
    DOMString expectedModel;
    DOMString model;
  };
  callback WorkspaceSyncCallback = void(WorkspaceSyncState state);

  enum OmniboxMatchKind {
    search,
    url
  };

  // One address-bar suggestion. Text is for display; the browser keeps the
  // real match and opens that, never a URL supplied by the page.
  dictionary OmniboxMatch {
    OmniboxMatchKind kind;
    DOMString contents;
    DOMString description;
    DOMString url;
    DOMString fillIntoEdit;
    DOMString inlineAutocompletion;
    // What Enter opens while nothing else is selected.
    boolean isDefault;
  };
  dictionary OmniboxResult {
    long revision;
    boolean done;
    OmniboxMatch[] matches;
  };
  dictionary OmniboxQuery {
    DOMString text;
    boolean preventInline;
  };
  // With a revision and index, opens that suggestion. Otherwise decides what
  // the text means exactly as the address bar does.
  dictionary OmniboxOpen {
    DOMString text;
    long? revision;
    long? index;
    long? tabId;
  };
  callback OmniboxResultCallback = void(OmniboxResult result);

  interface Events {
    // Bounded wake-up hint only. No key, credential or workspace payload.
    static void onSyncStateChanged();
  };

  interface Functions {
    static void readWorkspaceSync(WorkspaceSyncCallback callback);
    static void exchangeWorkspaceSync(WorkspaceSyncExchange request,
                                      WorkspaceSyncCallback callback);
    static void getAppearance(AppearanceCallback callback);
    static void setAppearance(
        AppearancePatch patch,
        AppearanceCallback callback);
    static void setSidebarCollapsed(
        boolean collapsed,
        optional VoidCallback callback);
    // Metadata only. No scripting, debugger or host permission is granted.
    static void getResearchTabs(ResearchTabsCallback callback);
    // One user-gesture-bound read of an exact document in the calling window.
    static void readResearchTab(long tabId, DOMString documentId,
                                DOMString expectedUrl,
                                ResearchTextCallback callback);
    static void authorizeCurrentPage(BooleanCallback callback);
    // One sample. Only the requested window in the calling regular profile
    // contributes tab titles; renderer IDs are local to this response.
    static void getBrowserStats(long windowId, BrowserStatsCallback callback);
    // Marks the live favourite tabs of the calling sidebar's own window, where
    // links open in a peek. Every other tab in that window is cleared. Unknown
    // or closed tab IDs are ignored.
    static void setPeekSources(
        long[] tabIds,
        optional VoidCallback callback);
    // Toggle a native split using a tab in this sidebar's browser window.
    // An active, unsplit tab opens Chromium's second-pane tab chooser.
    static void toggleSplitView(long tabId, optional VoidCallback callback);
    // Toggle the native extensions menu in the calling sidebar's window.
    static void showExtensionsMenu(optional VoidCallback callback);
    // The address bar's own suggestions for New Tab or the sidebar. Returns what is
    // ready now; nextOmniboxResult waits for anything newer. Empty text stops.
    static void queryOmnibox(OmniboxQuery query,
                             OmniboxResultCallback callback);
    static void nextOmniboxResult(long revision,
                                  OmniboxResultCallback callback);
    // Open text or a shown suggestion in New Tab or the sidebar's selected tab.
    static void openOmnibox(OmniboxOpen request,
                            optional VoidCallback callback);
    // Check whether the panel's active tab is a built-in full-page PDF viewer.
    static void isCurrentPdf(long tabId, BooleanCallback callback);
    // One user-gesture-bound capture of the active PDF's visible content.
    static void captureCurrentPdfContext(long tabId,
                                         PdfPageContextCallback callback);
  };
};
