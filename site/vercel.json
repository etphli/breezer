{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [{ "source": "/dashboard", "destination": "/api/dashboard" }],
  "redirects": [{ "source": "/privacy", "destination": "/privacy-policy", "permanent": true }],
  "crons": [{ "path": "/api/retention", "schedule": "0 4 * * *" }],
  "functions": { "api/*.js": { "maxDuration": 60 } },
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] },
    { "source": "/shots/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
